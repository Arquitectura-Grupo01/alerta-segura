# Plantilla de variables de entorno. Copiar a .env y ajustar.
# En Render estas mismas claves se cargan desde el panel del servicio.
# DEBUG, la CSP, el TLS de la base y la politica de salida a internet no son
# variables: son controles fijos en el codigo (config/settings y core/net.py).

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_ADMIN_PATH=admin/

# --- Servicios ------------------------------------------------------------
DATABASE_URL=postgres://alerta:alerta@localhost:5432/alerta
REDIS_URL=redis://localhost:6379/0
CELERY_EAGER=False

# --- Identidad del despliegue --------------------------------------------
# /health/ devuelve APP_ENV y el commit de RENDER_GIT_COMMIT, que Render
# define solo en cada despliegue (en local responde "unknown").
APP_ENV=local
LOG_LEVEL=INFO

# --- Solo produccion ------------------------------------------------------
# DJANGO_HSTS_SECONDS=31536000

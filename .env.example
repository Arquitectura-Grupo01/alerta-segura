# Plantilla de variables de entorno. Copiar a .env y ajustar.
# En Render estas mismas claves se cargan desde el panel del servicio.
# DEBUG, la CSP, el TLS de la base y la politica de salida a internet no son
# variables: son controles fijos en el codigo (config/settings y core/net.py).

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_ADMIN_PATH=admin/
# Dominio de producción que las páginas legales muestran como el único oficial.
ALERTA_DOMINIO_OFICIAL=alerta-segura.example

# --- Servicios ------------------------------------------------------------
DATABASE_URL=postgres://alerta:alerta@localhost:5432/alerta
REDIS_URL=redis://localhost:6379/0
# Caché compartida de Django: "redis" en local, "db" (tabla de PostgreSQL) en Render.
# Sin la variable se usa "db". Redis va en la base 1 para no mezclarse con el broker.
CACHE_BACKEND=redis
REDIS_CACHE_URL=redis://localhost:6379/1
CELERY_EAGER=False

# --- Identidad del despliegue --------------------------------------------
# /health/ devuelve APP_ENV y el commit de RENDER_GIT_COMMIT, que Render
# define solo en cada despliegue (en local responde "unknown").
APP_ENV=local
LOG_LEVEL=INFO

# --- Fuentes externas -----------------------------------------------------
# Una fuente sin clave se omite. Licencia, cuota y uso comercial de cada una en el
# README. Nunca se suben al repo: van en .env y en el panel de Render.
# Google Safe Browsing: Google Cloud, API "Safe Browsing" habilitada.
SAFE_BROWSING_API_KEY=
# URLhaus: Auth-Key de auth.abuse.ch.
ABUSE_CH_AUTH_KEY=
# PhishTank: clave de aplicación de phishtank.org.
PHISHTANK_APP_KEY=
# VirusTotal: clave de la API pública, en el perfil de la cuenta.
VIRUSTOTAL_API_KEY=
# urlscan.io: Settings & API de la cuenta.
URLSCAN_API_KEY=
# AbuseIPDB: Account, pestaña API.
ABUSEIPDB_API_KEY=

# --- Solo produccion ------------------------------------------------------
# DJANGO_HSTS_SECONDS=31536000
